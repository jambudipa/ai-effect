{
  "name": "@jambudipa/ai-effect",
  "version": "0.1.0",
  "description": "Effect v4 wrappers for the Vercel AI SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jambudipa/ai-effect.git"
  },
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./ai/test": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./cerebras": {
      "types": "./dist/providers/cerebras.d.ts",
      "import": "./dist/providers/cerebras.js",
      "default": "./dist/providers/cerebras.js"
    },
    "./svelte": {
      "types": "./dist/frameworks/svelte.d.ts",
      "svelte": "./dist/frameworks/svelte.js"
    },
    "./ui-utils": {
      "import": {
        "types": "./dist/integrations/ui-utils.d.ts",
        "import": "./dist/integrations/ui-utils.js",
        "default": "./dist/integrations/ui-utils.js"
      },
      "require": {
        "types": "./dist/integrations/ui-utils.d.cts",
        "default": "./dist/integrations/ui-utils.cjs"
      }
    },
    "./ui-utils/test": {
      "import": {
        "types": "./dist/integrations/ui-utils-test.d.ts",
        "import": "./dist/integrations/ui-utils-test.js",
        "default": "./dist/integrations/ui-utils-test.js"
      },
      "module": {
        "types": "./dist/integrations/ui-utils-test.d.ts",
        "import": "./dist/integrations/ui-utils-test.js",
        "default": "./dist/integrations/ui-utils-test.js"
      },
      "require": {
        "types": "./dist/integrations/ui-utils-test.d.cts",
        "default": "./dist/integrations/ui-utils-test.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vite build && vite build --mode legacy && tsc -p tsconfig.build.json && node scripts/copy-legacy-declarations.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format:check": "prettier --check src test scripts/*.mjs *.json *.mjs *.ts",
    "lint": "npm run lint:eslint; e=$?; npm run lint:effect; f=$?; exit $(( e > f ? e : f ))",
    "lint:eslint": "eslint src test --max-warnings=0",
    "lint:effect": "effect-language-service diagnostics --project tsconfig.json --format text --severity ${EFFECT_SEVERITY:-error,warning} --strict",
    "test": "vitest run",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "version": "changeset version"
  },
  "peerDependencies": {
    "effect": "^4.1.5",
    "svelte": "^5.31.0",
    "vitest": ">=5 <6"
  },
