{
  "name": "@jambudipa/ai-effect",
  "version": "0.1.0",
  "description": "Effect v4 wrappers for the Vercel AI SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jambudipa/ai-effect.git"
  },
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format:check": "prettier --check src test *.json *.mjs *.ts",
    "lint": "npm run lint:eslint; e=$?; npm run lint:effect; f=$?; exit $(( e > f ? e : f ))",
    "lint:eslint": "eslint src test --max-warnings=0",
    "lint:effect": "effect-language-service diagnostics --project tsconfig.json --format text --severity ${EFFECT_SEVERITY:-error,warning} --strict",
    "test": "vitest run",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "version": "changeset version"
  },
  "peerDependencies": {
    "ai": "^7.0.181",
    "effect": "^4.1.5"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "4.1.5",
    "@types/node": "24.19.4",
    "@typescript-eslint/parser": "8.74.0",
    "ai": "7.0.181",
    "effect": "4.1.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
