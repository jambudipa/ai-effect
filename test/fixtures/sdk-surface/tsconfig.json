{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": ".compiled",
    "allowJs": true
  },
  "include": ["core.mts", "shared.mjs"]
}
